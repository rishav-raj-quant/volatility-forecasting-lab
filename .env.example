# Volatility Forecasting Lab Environment Configuration Example
# Copy this file to .env and adjust variables as required.

# Market Data Providers
DEFAULT_MARKET=NSE
DEFAULT_TICKER=^NSEI
DEFAULT_START_DATE=2015-01-01
DEFAULT_END_DATE=2024-12-31
DATA_TIMEZONE=Asia/Kolkata

# Forecasting Horizons (comma-separated trading days)
FORECAST_HORIZONS=1,5,10,20

# Risk Analytics Parameters
VAR_CONFIDENCE_LEVELS=0.90,0.95,0.99
VAR_ESTIMATION_WINDOW=252
EWMA_LAMBDA=0.94

# Deep Learning Parameters
TORCH_DEVICE=cpu
RANDOM_SEED=42

# Logging & Storage
LOG_LEVEL=INFO
DATA_DIR=data
RESULTS_DIR=experiments/results
